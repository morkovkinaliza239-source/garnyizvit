---
import Base from '../layouts/Base.astro';
const pageUrl = 'https://garnyizvit.org.ua/buhgalter-dlya-kavyarni/';
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Бухгалтер для кав'ярні: управлінський облік і супровід ФОП",
    "serviceType": "Бухгалтерський супровід і управлінський облік для кав'ярень",
    "url": pageUrl,
    "areaServed": { "@type": "Country", "name": "Україна" },
    "provider": {
      "@type": "Organization",
      "name": "Гарний Звіт",
      "url": "https://garnyizvit.org.ua/",
      "telephone": "+380930185887"
    },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "UAH",
      "price": "2000",
      "description": "Від 2000 грн на місяць, плюс 500 грн за кожного найманого працівника"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Головна", "item": "https://garnyizvit.org.ua/" },
      { "@type": "ListItem", "position": 2, "name": "Послуги", "item": "https://garnyizvit.org.ua/poslugy/" },
      { "@type": "ListItem", "position": 3, "name": "Бухгалтер для кав'ярні", "item": pageUrl }
    ]
  }
];
---
<Base title="Бухгалтер для кав'ярні в Броварах: управлінський облік і супровід ФОП — Гарний Звіт" description="Бухгалтер для кав'ярні в Броварах і по всій Україні онлайн: управлінський облік, ПРРО, податки, зарплата, звітність ФОП. Від 2000 грн/міс.">
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
<main>
  <section style="max-width:1080px;margin:0 auto;padding:var(--space-8) var(--space-6)">
    <p style="font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-accent-700);margin-bottom:var(--space-4)">Бровари · онлайн по всій Україні</p>
    <h1 style="font-size:clamp(34px,4.6vw,54px);font-weight:400;line-height:1.08;margin:0 0 var(--space-4);max-width:24ch">Бухгалтер для кав'ярні в Броварах: управлінський облік і супровід ФОП</h1>
    <p style="text-align:justify;hyphens:auto;font-size:17px;line-height:1.65;max-width:58ch;color:var(--color-neutral-800)">Налагоджую в кав'ярні управлінський облік у спеціалізованій програмі для закладів: каса й ПРРО, склад, меню з техкартами, витрати та звіти. Ви бачите собівартість напоїв, залишки, прибутковість позицій і рух коштів, а я веду бухгалтерію ФОП: податки, ЄСВ, зарплату й звітність. Працюю дистанційно, тож підходжу кав'ярням у Броварах, Київській області та по всій Україні.</p>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);margin-top:var(--space-6)">
      <a class="btn btn-primary" href="https://t.me/+380930185887" target="_blank" rel="noreferrer">Написати в Telegram</a>
      <a class="btn btn-secondary" href="tel:+380930185887">Подзвонити</a>
    </div>
  </section>

  <section style="border-top:1px solid var(--color-divider)">
    <div style="max-width:1080px;margin:0 auto;padding:var(--space-8) var(--space-6)">
      <h2 style="font-size:34px;font-weight:400;margin:0 0 var(--space-4)">Бухгалтерський супровід кав'ярні в Броварах</h2>
      <p style="max-width:62ch;color:var(--color-neutral-800);text-align:justify;margin:0 0 var(--space-4)">Шукаєте бухгалтера для кав'ярні (інколи пишуть «кавярні») в Броварах? Супровід повністю дистанційний: договір, ключ ЕЦП, документи й звітність в електронному вигляді, а спілкування в Telegram або по телефону. Тому для кав'ярні в Броварах він такий самий, як для закладу в будь-якому іншому місті.</p>
      <p style="max-width:62ch;color:var(--color-neutral-800);text-align:justify;margin:0 0 var(--space-4)">Що я роблю для кав'ярень у Броварах: допомагаю відкрити заклад (реєстрація ФОП, вибір групи та КВЕДів), налаштовую управлінський облік, підключаю ПРРО, веду облік і податки, рахую зарплату працівників і подаю звітність у строк.</p>
      <p style="max-width:62ch;color:var(--color-neutral-800);text-align:justify;margin:0">Для ФОП 1 і 2 груп ставку єдиного податку встановлює місцева рада, тому перед стартом перевіряю чинне рішення Броварської міської ради.</p>
    </div>
  </section>

  <section style="border-top:1px solid var(--color-divider)">
    <div style="max-width:1080px;margin:0 auto;padding:var(--space-8) var(--space-6)">
      <h2 style="font-size:34px;font-weight:400;margin:0 0 var(--space-4)">Управлінський облік у кав'ярні: що налаштовую</h2>
      <p style="max-width:62ch;color:var(--color-neutral-800);text-align:justify;margin:0 0 var(--space-6)">Бухгалтерський облік потрібен для податків, а управлінський: щоб ви розуміли, скільки насправді заробляє кав'ярня. Налаштовую його в програмі для закладів, щоб цифри з каси й складу складалися в зрозумілі звіти. Докладно про це: <a href="/blog/upravlinskyi-oblik-kavyarnya/">стаття про управлінський облік у кав'ярні</a>.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:var(--space-4)">
        <div class="card">
          <span class="card-kicker">Меню</span>
          <span class="card-title">Техкарти й собівартість</span>
          <p class="card-body">Кожен напій і десерт описується техкартою: склад, вихід, собівартість. Ціна в меню спирається на реальні витрати.</p>
        </div>
        <div class="card">
          <span class="card-kicker">Склад</span>
          <span class="card-title">Залишки й списання</span>
          <p class="card-body">Надходження від постачальників, списання, інвентаризація: видно, що закінчується і де виникають втрати.</p>
        </div>
        <div class="card">
          <span class="card-kicker">Каса</span>
          <span class="card-title">Каса та ПРРО</span>
          <p class="card-body">Налаштування каси та програмного РРО, щоб кожен розрахунок супроводжувався фіскальним чеком.</p>
        </div>
        <div class="card">
          <span class="card-kicker">Аналітика</span>
          <span class="card-title">Звіти й ABC-аналіз</span>
          <p class="card-body">Які позиції дають основну частину виручки й прибутку, а які лише займають місце на складі.</p>
        </div>
        <div class="card">
          <span class="card-kicker">Фінанси</span>
          <span class="card-title">Витрати й рух коштів</span>
          <p class="card-body">Облік витрат (оренда, зарплата, закупівлі) і руху коштів: видно прибуток закладу, а не лише виручку.</p>
        </div>
        <div class="card">
          <span class="card-kicker">Доступи</span>
          <span class="card-title">Права працівників</span>
          <p class="card-body">Розмежування прав доступу: працівники виконують свої операції, а звіти й чутливі дані бачить власник.</p>
        </div>
      </div>
    </div>
  </section>

  <section style="border-top:1px solid var(--color-divider)">
    <div style="max-width:1080px;margin:0 auto;padding:var(--space-8) var(--space-6)">
      <h2 style="font-size:34px;font-weight:400;margin:0 0 var(--space-6)">Бухгалтерський супровід ФОП</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:var(--space-4)">
        <div class="card">
          <span class="card-kicker">Щомісяця</span>
          <span class="card-title">Облік і податки</span>
          <p class="card-body">Облік доходів, розрахунок єдиного податку та ЄСВ, нагадування про платежі до дедлайну.</p>
        </div>
        <div class="card">
          <span class="card-kicker">Кадри</span>
          <span class="card-title">Працівники</span>
          <p class="card-body">Оформлення бариста й адміністраторів, нарахування зарплати, повідомлення про прийняття, лікарняні та відпустки.</p>
        </div>
        <div class="card">
          <span class="card-kicker">Звітність</span>
          <span class="card-title">Декларації та звіти</span>
          <p class="card-body">Квартальні та річні декларації, звітність по ЄСВ і працівниках: подання через електронний кабінет платника.</p>
        </div>
        <div class="card">
          <span class="card-kicker">Старт</span>
          <span class="card-title">Відкриття кав'ярні</span>
          <p class="card-body">Реєстрація ФОП, вибір групи та КВЕДів, заява на єдиний податок, відкриття рахунку.</p>
        </div>
        <div class="card">
          <span class="card-kicker">Порядок</span>
          <span class="card-title">Відновлення обліку</span>
          <p class="card-body">Аудит минулих періодів, виправлення помилок, уточнюючі декларації.</p>
        </div>
      </div>
      <p style="max-width:62ch;color:var(--color-neutral-800);text-align:justify;margin:var(--space-6) 0 0">Усі напрямки роботи дивіться на сторінці <a href="/poslugy/">«Послуги»</a>.</p>
    </div>
  </section>

  <section style="border-top:1px solid var(--color-divider)">
    <div style="max-width:1080px;margin:0 auto;padding:var(--space-8) var(--space-6)">
      <h2 style="font-size:34px;font-weight:400;margin:0 0 var(--space-4)">Що врахувати до відкриття кав'ярні</h2>
      <ul style="max-width:62ch;color:var(--color-neutral-800);line-height:1.7;margin:0 0 var(--space-4);padding-left:1.2em">
        <li>Група ФОП і ліміт доходу: що буде, якщо його перевищити, читайте в статті <a href="/blog/limit-dokhodu/">«Ліміт доходу ФОП»</a>.</li>
        <li>КВЕДи, які відповідають формату закладу (дивіться нижче).</li>
        <li>ПРРО та договір еквайрингу з банком.</li>
        <li>Програма обліку з техкартами, складом і касою.</li>
        <li>Оформлення працівників і повідомлення про прийняття на роботу.</li>
        <li>Продаж алкоголю має окремі вимоги, їх треба з'ясувати до реєстрації.</li>
      </ul>
      <p style="max-width:62ch;color:var(--color-neutral-800);text-align:justify;margin:0">Покроково про реєстрацію: <a href="/blog/yak-vidkryty-fop-2027/">«Як відкрити ФОП у 2027 році»</a>.</p>
    </div>
  </section>

  <section style="border-top:1px solid var(--color-divider)">
    <div style="max-width:1080px;margin:0 auto;padding:var(--space-8) var(--space-6)">
      <h2 style="font-size:34px;font-weight:400;margin:0 0 var(--space-4)">КВЕДи для кав'ярні</h2>
      <p style="max-width:62ch;color:var(--color-neutral-800);text-align:justify;margin:0 0 var(--space-6)">КВЕДи вказують під час реєстрації ФОП або додають пізніше заявою про зміни. Набір залежить від формату закладу. Найчастіше для кав'ярні підходять такі:</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:var(--space-4)">
        <div class="card">
          <span class="card-kicker">56.30</span>
          <span class="card-title">Обслуговування напоями</span>
          <p class="card-body">Основний код для кав'ярні, яка готує й продає каву, чай та інші напої для споживання на місці.</p>
        </div>
        <div class="card">
          <span class="card-kicker">56.10</span>
          <span class="card-title">Діяльність ресторанів, надання послуг мобільного харчування</span>
          <p class="card-body">Потрібен, якщо ви готуєте їжу й десерти, продаєте їх на винос або доставляєте.</p>
        </div>
        <div class="card">
          <span class="card-kicker">47.24</span>
          <span class="card-title">Роздрібна торгівля хлібобулочними та кондитерськими виробами в спеціалізованих магазинах</span>
          <p class="card-body">Підходить, якщо продаєте випічку й кондитерські вироби як окремий товар.</p>
        </div>
        <div class="card">
          <span class="card-kicker">47.25</span>
          <span class="card-title">Роздрібна торгівля напоями в спеціалізованих магазинах</span>
          <p class="card-body">Підходить, якщо продаєте напої як у магазині.</p>
        </div>
        <div class="card">
          <span class="card-kicker">56.21 / 56.29</span>
          <span class="card-title">Постачання готових страв для подій / інших готових страв</span>
          <p class="card-body">Якщо плануєте кейтеринг або виїзне обслуговування.</p>
        </div>
      </div>
      <p style="max-width:62ch;color:var(--color-neutral-800);text-align:justify;margin:var(--space-6) 0 0">Для ФОП 2 групи діяльність у сфері ресторанного господарства дозволена, але діють обмеження групи: ліміт доходу та не більше 10 найманих працівників. Продаж алкоголю має окремі вимоги, їх варто з'ясувати до реєстрації. Підберу КВЕДи під формат вашого закладу.</p>
    </div>
  </section>

  <section style="border-top:1px solid var(--color-divider)">
    <div style="max-width:1080px;margin:0 auto;padding:var(--space-8) var(--space-6)">
      <h2 style="font-size:34px;font-weight:400;margin:0 0 var(--space-4)">Вартість</h2>
      <p style="max-width:56ch;color:var(--color-neutral-800);text-align:justify">Бухгалтерський супровід ФОП: <strong>2000 грн на місяць</strong> для ФОП без найманих працівників і <strong>+500 грн</strong> за кожного працівника. Наприклад, кав'ярня з трьома працівниками обійдеться в 3500 грн на місяць. Налаштування управлінського обліку залежить від закладу, вартість називаю після короткої розмови. Оплата щомісяця, без довгих контрактів. Що входить у супровід, дивіться на сторінці <a href="/taryfy/">«Тарифи»</a>.</p>
    </div>
  </section>

  <section style="border-top:1px solid var(--color-divider)">
    <div style="max-width:1080px;margin:0 auto;padding:var(--space-8) var(--space-6)">
      <h2 style="font-size:34px;font-weight:400;margin:0 0 var(--space-6)">Як ми працюємо</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:var(--space-6)">
        <div>
          <p style="font-family:var(--font-heading);font-size:44px;line-height:1;font-weight:400;color:var(--color-accent);margin:0 0 var(--space-3)">01</p>
          <h3 style="font-size:19px;font-weight:600;margin:0 0 var(--space-2)">Знайомство</h3>
          <p style="margin:0;font-size:14px;color:var(--color-neutral-800)">Коротка розмова у Telegram або по телефону: група, працівники, формат кав'ярні, чи вже є програма обліку.</p>
        </div>
        <div>
          <p style="font-family:var(--font-heading);font-size:44px;line-height:1;font-weight:400;color:var(--color-accent);margin:0 0 var(--space-3)">02</p>
          <h3 style="font-size:19px;font-weight:600;margin:0 0 var(--space-2)">Налаштування</h3>
          <p style="margin:0;font-size:14px;color:var(--color-neutral-800)">Налаштовую меню й техкарти, склад, касу та ПРРО, права доступу. Готую звіти, які потрібні власнику.</p>
        </div>
        <div>
          <p style="font-family:var(--font-heading);font-size:44px;line-height:1;font-weight:400;color:var(--color-accent);margin:0 0 var(--space-3)">03</p>
          <h3 style="font-size:19px;font-weight:600;margin:0 0 var(--space-2)">Супровід</h3>
          <p style="margin:0;font-size:14px;color:var(--color-neutral-800)">Щомісяця бухгалтерія ФОП: податки, ЄСВ, зарплата й звітність у строк, а також розбір цифр кав'ярні.</p>
        </div>
      </div>
    </div>
  </section>

  <section style="border-top:1px solid var(--color-divider)">
    <div style="max-width:760px;margin:0 auto;padding:var(--space-8) var(--space-6)">
      <h2 style="font-size:34px;font-weight:400;margin:0 0 var(--space-6)">Питання й відповіді</h2>

      <h3 style="font-size:19px;font-weight:600;margin:0 0 var(--space-2)">Чи працюєте з кав'ярнями в Броварах?</h3>
      <p style="margin:0 0 var(--space-6);color:var(--color-neutral-800)">Так. Супровід дистанційний: договір, документи, підписи й звітність в електронному вигляді, а спілкування в Telegram або по телефону. Для кав'ярні в Броварах він такий самий, як для закладу в будь-якому іншому місті.</p>

      <h3 style="font-size:19px;font-weight:600;margin:0 0 var(--space-2)">Що таке управлінський облік у кав'ярні?</h3>
      <p style="margin:0 0 var(--space-6);color:var(--color-neutral-800)">Це облік для ваших рішень: скільки коштує кожен напій, що в залишках, які позиції найприбутковіші, куди йдуть витрати. Бухгалтерський облік потрібен для податків і звітності. Налаштовую обидва.</p>

      <h3 style="font-size:19px;font-weight:600;margin:0 0 var(--space-2)">Які КВЕДи потрібні для кав'ярні?</h3>
      <p style="margin:0 0 var(--space-6);color:var(--color-neutral-800)">Найчастіше це 56.30 (обслуговування напоями) і 56.10 (ресторани, мобільне харчування). Якщо продаєте випічку чи напої як у магазині, додають 47.24 або 47.25. Точний набір залежить від формату закладу.</p>

      <h3 style="font-size:19px;font-weight:600;margin:0 0 var(--space-2)">Скільки коштує бухгалтер для кав'ярні в Броварах?</h3>
      <p style="margin:0 0 var(--space-6);color:var(--color-neutral-800)">2000 грн на місяць плюс 500 грн за кожного найманого працівника. Вартість налаштування управлінського обліку назву після короткої розмови.</p>

      <h3 style="font-size:19px;font-weight:600;margin:0 0 var(--space-2)">Чи потрібен ПРРО для кав'ярні?</h3>
